# Ambiente de homologação: valores econômicos e removíveis após os testes.
environment                    = "homolog"
aws_region                     = "us-east-1"
vpc_cidr                       = "10.40.0.0/16"
availability_zones             = ["us-east-1a", "us-east-1b"] # Confirmadas pelo AWS Academy Lab
db_instance_identifier         = "gearflow-sqlserver-homolog"
db_instance_class              = "db.t3.micro"
sqlserver_engine_version       = "16.00.4255.1.v1" # SQL Server 2022 disponível no AWS Academy Lab
allocated_storage_gib          = 20
max_allocated_storage_gib      = 100
multi_az                       = false
backup_retention_days          = 7
deletion_protection            = false
skip_final_snapshot            = true
secret_recovery_window_in_days = 7

# RDS é privado (publicly_accessible = false): sem CIDRs liberados. Preencha
# allowed_security_group_ids com o ID do security group da Lambda check-client
# (output "check_client_lambda_security_group_id" em gearflow-lambda) depois do
# apply daquele repositório.
allowed_cidr_blocks        = []
# Inclua os SGs do runner privado e da Lambda apos ambos existirem. Nao use
# 0.0.0.0/0: estes IDs sao o unico caminho TCP/1433 autorizado ao RDS.
allowed_security_group_ids = []
